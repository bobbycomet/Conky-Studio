  "plugins": [
    {
      "id": "logic.map_range",
      "category": "logic",
      "label": "Map Range",
      "author": "conky-studio",
      "version": "1.0.0",
      "description": "Remap a number from one range into another (e.g. 0–100 °C → 0–1, or sensor raw → percent). Clamps to the output range by default.",
      "color": "#6b9bd1",
      "subcategory": "Plugins",
      "output_kind": "number",
      "tags": ["math", "remap", "scale"],
      "simple_mode": true,
      "properties": [
        {
          "key": "value",
          "label": "Value",
          "kind": "float",
          "default": 50,
          "minimum": -1000000000.0,
          "maximum": 1000000000.0,
          "bindable": true,
          "accepts": ["number", "percent", "celsius"],
          "group": "Input",
          "help": "Incoming value to remap"
        },
        {
          "key": "in_min",
          "label": "In min",
          "kind": "float",
          "default": 0,
          "minimum": -1000000000.0,
          "maximum": 1000000000.0,
          "bindable": true,
          "accepts": ["number", "percent", "celsius"],
          "group": "Input range"
        },
        {
          "key": "in_max",
          "label": "In max",
          "kind": "float",
          "default": 100,
          "minimum": -1000000000.0,
          "maximum": 1000000000.0,
          "bindable": true,
          "accepts": ["number", "percent", "celsius"],
          "group": "Input range"
        },
        {
          "key": "out_min",
          "label": "Out min",
          "kind": "float",
          "default": 0,
          "minimum": -1000000000.0,
          "maximum": 1000000000.0,
          "bindable": true,
          "accepts": ["number", "percent"],
          "group": "Output range"
        },
        {
          "key": "out_max",
          "label": "Out max",
          "kind": "float",
          "default": 1,
          "minimum": -1000000000.0,
          "maximum": 1000000000.0,
          "bindable": true,
          "accepts": ["number", "percent"],
          "group": "Output range"
        },
        {
          "key": "clamp_out",
          "label": "Clamp output",
          "kind": "bool",
          "default": true,
          "group": "Behaviour",
          "help": "If on, result stays between out min and out max"
        }
      ],
      "lua_expr": "(function()\n local v, a, b, c, d = {value}, {in_min}, {in_max}, {out_min}, {out_max}\n local span = b - a\n if span == 0 then return c end\n local t = (v - a) / span\n local r = c + t * (d - c)\n if {clamp_out} then\n local lo, hi = math.min(c, d), math.max(c, d)\n if r < lo then r = lo elseif r > hi then r = hi end\n end\n return r\nend)()"
    },
    {
      "id": "logic.lerp",
      "category": "logic",
      "label": "Lerp",
      "author": "conky-studio",
      "version": "1.0.0",
      "description": "Linear blend between A and B by T (0 = all A, 1 = all B). T is clamped to 0–1.",
      "color": "#7a9ed6",
      "subcategory": "Plugins",
      "output_kind": "number",
      "tags": ["math", "blend", "mix"],
      "simple_mode": true,
      "properties": [
        {
          "key": "a",
          "label": "A",
          "kind": "float",
          "default": 0,
          "minimum": -1000000000.0,
          "maximum": 1000000000.0,
          "bindable": true,
          "accepts": ["number", "percent", "celsius"],
          "group": "Values"
        },
        {
          "key": "b",
          "label": "B",
          "kind": "float",
          "default": 100,
          "minimum": -1000000000.0,
          "maximum": 1000000000.0,
          "bindable": true,
          "accepts": ["number", "percent", "celsius"],
          "group": "Values"
        },
        {
          "key": "t",
          "label": "T (0–1)",
          "kind": "float",
          "default": 0.5,
          "minimum": 0,
          "maximum": 1,
          "step": 0.01,
          "bindable": true,
          "accepts": ["number", "percent"],
          "group": "Mix",
          "help": "Blend factor. Wire a percent source and divide by 100 upstream, or use 0–1 directly."
        }
      ],
      "lua_expr": "(function()\n local t = {t}\n if t < 0 then t = 0 elseif t > 1 then t = 1 end\n return {a} + ({b} - {a}) * t\nend)()"
    },
    {
      "id": "logic.threshold",
      "category": "logic",
      "label": "Threshold",
      "author": "conky-studio",
      "version": "1.0.0",
      "description": "Compare a value to a threshold. Outputs either a boolean-style 0/1, or passes the original value when the condition holds (gate mode). Useful for glow triggers, swap triggers, and alert bands.",
      "color": "#d4a05a",
      "subcategory": "Plugins",
      "output_kind": "number",
      "tags": ["compare", "gate", "trigger"],
      "simple_mode": true,
      "properties": [
        {
          "key": "value",
          "label": "Value",
          "kind": "float",
          "default": 50,
          "minimum": -1000000000.0,
          "maximum": 1000000000.0,
          "bindable": true,
          "accepts": ["number", "percent", "celsius"],
          "group": "Input"
        },
        {
          "key": "threshold",
          "label": "Threshold",
          "kind": "float",
          "default": 80,
          "minimum": -1000000000.0,
          "maximum": 1000000000.0,
          "bindable": true,
          "accepts": ["number", "percent", "celsius"],
          "group": "Input"
        },
        {
          "key": "mode",
          "label": "Mode",
          "kind": "enum",
          "default": "above",
          "choices": ["above", "below", "equal"],
          "choice_labels": ["Above (≥)", "Below (≤)", "Equal (±ε)"],
          "group": "Compare"
        },
        {
          "key": "output_mode",
          "label": "Output",
          "kind": "enum",
          "default": "binary",
          "choices": ["binary", "gate", "invert_binary"],
          "choice_labels": ["0 or 1", "Pass value when true, else 0", "1 or 0 (inverted)"],
          "group": "Output",
          "help": "binary → 1 when condition holds. gate → original value when true, else 0. invert_binary flips the 0/1."
        },
        {
          "key": "epsilon",
          "label": "Equal ε",
          "kind": "float",
          "default": 0.01,
          "minimum": 0,
          "maximum": 1000000.0,
          "step": 0.01,
          "group": "Compare",
          "help": "Tolerance used only when Mode is Equal"
        }
      ],
      "lua_expr": "(function()\n local v, th, eps = {value}, {threshold}, {epsilon}\n local mode, outm = '{mode}', '{output_mode}'\n local ok = false\n if mode == 'above' then ok = (v >= th)\n elseif mode == 'below' then ok = (v <= th)\n else ok = (math.abs(v - th) <= eps)\n end\n if outm == 'gate' then return ok and v or 0 end\n if outm == 'invert_binary' then return ok and 0 or 1 end\n return ok and 1 or 0\nend)()"
    },
    {
      "id": "logic.deadzone",
      "category": "logic",
      "label": "Deadzone",
      "author": "conky-studio",
      "version": "1.0.0",
      "description": "Zero-out values whose absolute magnitude is below a threshold. Optional soft ramp so the edge is not a hard cliff. Great for noisy net/CPU deltas and joystick-style inputs.",
      "color": "#8a8fa8",
      "subcategory": "Plugins",
      "output_kind": "number",
      "tags": ["filter", "noise", "math"],
      "simple_mode": false,
      "properties": [
        {
          "key": "value",
          "label": "Value",
          "kind": "float",
          "default": 0,
          "minimum": -1000000000.0,
          "maximum": 1000000000.0,
          "bindable": true,
          "accepts": ["number", "percent", "celsius"],
          "group": "Input"
        },
        {
          "key": "zone",
          "label": "Deadzone",
          "kind": "float",
          "default": 1,
          "minimum": 0,
          "maximum": 1000000000.0,
          "bindable": true,
          "accepts": ["number", "percent"],
          "group": "Filter",
          "help": "Values with |value| < deadzone become 0 (or are scaled in soft mode)"
        },
        {
          "key": "soft",
          "label": "Soft edge",
          "kind": "bool",
          "default": false,
          "group": "Filter",
          "help": "If on, rescale so the deadzone is removed and the rest maps smoothly outward"
        }
      ],
      "lua_expr": "(function()\n local v, z = {value}, {zone}\n if z < 0 then z = 0 end\n local a = math.abs(v)\n if a <= z then return 0 end\n if not {soft} then return v end\n local sign = (v >= 0) and 1 or -1\n return sign * (a - z)\nend)()"
    },
    {
      "id": "logic.smooth",
      "category": "logic",
      "label": "Smooth (EMA)",
      "author": "conky-studio",
      "version": "1.0.0",
      "description": "Exponential moving average — tames jittery sensors (CPU, net, GPU) before they hit rings/bars. Each node needs a unique Slot so parallel smoothers do not share state.",
      "color": "#5fb89a",
      "subcategory": "Plugins",
      "output_kind": "number",
      "tags": ["filter", "ema", "smooth"],
      "simple_mode": true,
      "lua_helpers": "local _cs_plugin_smooth = _cs_plugin_smooth or {}\n",
      "properties": [
        {
          "key": "value",
          "label": "Value",
          "kind": "float",
          "default": 0,
          "minimum": -1000000000.0,
          "maximum": 1000000000.0,
          "bindable": true,
          "accepts": ["number", "percent", "celsius"],
          "group": "Input"
        },
        {
          "key": "alpha",
          "label": "Alpha",
          "kind": "float",
          "default": 0.2,
          "minimum": 0.01,
          "maximum": 1,
          "step": 0.01,
          "bindable": true,
          "accepts": ["number"],
          "group": "Filter",
          "help": "1 = no smoothing (follow input). Smaller = heavier lag. 0.15–0.3 is a good starting band for CPU/net."
        },
        {
          "key": "slot",
          "label": "Slot",
          "kind": "int",
          "default": 1,
          "minimum": 1,
          "maximum": 9999,
          "step": 1,
          "group": "State",
          "help": "Unique integer per Smooth node in the project (1, 2, 3…). Shared slots share the same smoothed memory."
        }
      ],
      "lua_expr": "(function()\n local k = {slot}\n local v, a = {value}, {alpha}\n if a < 0.01 then a = 0.01 elseif a > 1 then a = 1 end\n local s = _cs_plugin_smooth\n if s[k] == nil then s[k] = v end\n s[k] = s[k] + (v - s[k]) * a\n return s[k]\nend)()"
    },
    {
      "id": "logic.temp_convert",
      "category": "logic",
      "label": "Temp Convert",
      "author": "conky-studio",
      "version": "1.0.0",
      "description": "Convert temperature between Fahrenheit and Celsius. Wire your weather (or any °F/°C source) in, pick the direction, and feed rings, labels, or thresholds in the unit you want.",
      "color": "#5eb0c9",
      "subcategory": "Plugins",
      "output_kind": "celsius",
      "tags": ["weather", "temperature", "units", "convert"],
      "simple_mode": true,
      "properties": [
        {
          "key": "value",
          "label": "Temperature",
          "kind": "float",
          "default": 72,
          "minimum": -200,
          "maximum": 200,
          "step": 0.1,
          "bindable": true,
          "accepts": ["number", "celsius", "percent"],
          "group": "Input",
          "help": "Incoming temperature. Accepts a weather/source node that reports °F or °C."
        },
        {
          "key": "direction",
          "label": "Convert",
          "kind": "enum",
          "default": "f_to_c",
          "choices": ["f_to_c", "c_to_f"],
          "choice_labels": ["°F → °C", "°C → °F"],
          "group": "Units",
          "help": "°F → °C: (F − 32) × 5/9. °C → °F: C × 9/5 + 32."
        },
        {
          "key": "decimals",
          "label": "Round to",
          "kind": "enum",
          "default": "1",
          "choices": ["none", "0", "1", "2"],
          "choice_labels": ["No rounding", "Whole degrees", "1 decimal", "2 decimals"],
          "group": "Output",
          "help": "Optional rounding so labels stay tidy (e.g. 21.3 instead of 21.333…)."
        }
      ],
      "lua_expr": "(function()\n local v = {value}\n local dir = '{direction}'\n local out\n if dir == 'c_to_f' then\n out = v * 9 / 5 + 32\n else\n out = (v - 32) * 5 / 9\n end\n local d = '{decimals}'\n if d == '0' then return math.floor(out + 0.5)\n elseif d == '1' then return math.floor(out * 10 + 0.5) / 10\n elseif d == '2' then return math.floor(out * 100 + 0.5) / 100\n end\n return out\nend)()"
    },
    {
      "id": "logic.threshold_chain_10",
      "category": "logic",
      "label": "Threshold Chain (10-Stage)",
      "author": "conky-studio",
      "version": "1.1.0",
      "description": "Map one number onto up to 10 progressive stages. Output is a stage index (0 = below all, 1…N = highest step passed). Drive Image Chain slots, Chain Pick (rotation/opacity/scale), text visibility, glow triggers, or any numeric input — not images only.",
      "color": "#d4825a",
      "subcategory": "Plugins",
      "output_kind": "number",
      "tags": ["chain", "threshold", "multi-stage", "swap", "asset", "battery", "signal"],
      "simple_mode": true,
      "properties": [
        {
          "key": "value",
          "label": "Input value",
          "kind": "float",
          "default": 0,
          "minimum": -1000000000.0,
          "maximum": 1000000000.0,
          "bindable": true,
          "accepts": ["number", "percent", "celsius"],
          "group": "Input",
          "help": "Battery %, signal, RPM, CPU, temperature — any scalar."
        },
        {
          "key": "steps_count",
          "label": "Active steps",
          "kind": "int",
          "default": 4,
          "minimum": 1,
          "maximum": 10,
          "group": "Configuration",
          "help": "Only the first N thresholds are evaluated (1–10)."
        },
        {
          "key": "mode",
          "label": "Mode",
          "kind": "enum",
          "default": "progressive",
          "choices": ["progressive", "highest", "exact_band"],
          "choice_labels": [
            "Progressive (must pass 1, then 2, …)",
            "Highest only (any step ≥ its threshold)",
            "Exact band (step i if t[i] ≤ v < t[i+1])"
          ],
          "group": "Configuration",
          "help": "Progressive: classic battery bars (must clear lower steps). Highest: last threshold the value meets. Exact band: one stage at a time between cut-points."
        },
        {
          "key": "none_value",
          "label": "Below all →",
          "kind": "float",
          "default": 0,
          "minimum": 0,
          "maximum": 10,
          "group": "Output",
          "help": "Output when the value is under every active threshold (usually 0)."
        },
        {
          "key": "t1",
          "label": "Step 1 ≥",
          "kind": "float",
          "default": 10,
          "minimum": -1000000000.0,
          "maximum": 1000000000.0,
          "bindable": true,
          "accepts": ["number", "percent", "celsius"],
          "group": "Thresholds"
        },
        {
          "key": "t2",
          "label": "Step 2 ≥",
          "kind": "float",
          "default": 25,
          "minimum": -1000000000.0,
          "maximum": 1000000000.0,
          "bindable": true,
          "accepts": ["number", "percent", "celsius"],
          "group": "Thresholds"
        },
        {
          "key": "t3",
          "label": "Step 3 ≥",
          "kind": "float",
          "default": 50,
          "minimum": -1000000000.0,
          "maximum": 1000000000.0,
          "bindable": true,
          "accepts": ["number", "percent", "celsius"],
          "group": "Thresholds"
        },
        {
          "key": "t4",
          "label": "Step 4 ≥",
          "kind": "float",
          "default": 75,
          "minimum": -1000000000.0,
          "maximum": 1000000000.0,
          "bindable": true,
          "accepts": ["number", "percent", "celsius"],
          "group": "Thresholds"
        },
        {
          "key": "t5",
          "label": "Step 5 ≥",
          "kind": "float",
          "default": 90,
          "minimum": -1000000000.0,
          "maximum": 1000000000.0,
          "bindable": true,
          "accepts": ["number", "percent", "celsius"],
          "group": "Thresholds"
        },
        {
          "key": "t6",
          "label": "Step 6 ≥",
          "kind": "float",
          "default": 100,
          "minimum": -1000000000.0,
          "maximum": 1000000000.0,
          "bindable": true,
          "accepts": ["number", "percent", "celsius"],
          "group": "Thresholds"
        },
        {
          "key": "t7",
          "label": "Step 7 ≥",
          "kind": "float",
          "default": 110,
          "minimum": -1000000000.0,
          "maximum": 1000000000.0,
          "bindable": true,
          "accepts": ["number", "percent", "celsius"],
          "group": "Thresholds"
        },
        {
          "key": "t8",
          "label": "Step 8 ≥",
          "kind": "float",
          "default": 120,
          "minimum": -1000000000.0,
          "maximum": 1000000000.0,
          "bindable": true,
          "accepts": ["number", "percent", "celsius"],
          "group": "Thresholds"
        },
        {
          "key": "t9",
          "label": "Step 9 ≥",
          "kind": "float",
          "default": 130,
          "minimum": -1000000000.0,
          "maximum": 1000000000.0,
          "bindable": true,
          "accepts": ["number", "percent", "celsius"],
          "group": "Thresholds"
        },
        {
          "key": "t10",
          "label": "Step 10 ≥",
          "kind": "float",
          "default": 140,
          "minimum": -1000000000.0,
          "maximum": 1000000000.0,
          "bindable": true,
          "accepts": ["number", "percent", "celsius"],
          "group": "Thresholds"
        }
      ],
      "lua_expr": "(function()\n local v = {value}\n if type(v) ~= 'number' then v = tonumber(v) or 0 end\n local count = math.floor({steps_count} + 0.5)\n if count < 1 then count = 1 elseif count > 10 then count = 10 end\n local t = { {t1}, {t2}, {t3}, {t4}, {t5}, {t6}, {t7}, {t8}, {t9}, {t10} }\n local mode = '{mode}'\n if mode == 'exact_band' then\n for i = 1, count do\n local lo = t[i]\n local hi = (i < count) and t[i + 1] or nil\n if type(lo) ~= 'number' then lo = tonumber(lo) or 0 end\n if hi ~= nil and type(hi) ~= 'number' then hi = tonumber(hi) end\n if v >= lo and (hi == nil or v < hi) then return i end\n end\n local last = t[count]\n if type(last) ~= 'number' then last = tonumber(last) or 0 end\n if v >= last then return count end\n return {none_value}\n end\n if mode == 'highest' then\n local best = 0\n for i = 1, count do\n local th = t[i]\n if type(th) ~= 'number' then th = tonumber(th) or 0 end\n if v >= th then best = i end\n end\n if best == 0 then return {none_value} end\n return best\n end\n local active = 0\n for i = 1, count do\n local th = t[i]\n if type(th) ~= 'number' then th = tonumber(th) or 0 end\n if v >= th then active = i else break end\n end\n if active == 0 then return {none_value} end\n return active\nend)()"
    },
