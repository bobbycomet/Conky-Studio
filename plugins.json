  "plugins": [
    {
      "id": "logic.threshold",
      "category": "logic",
      "label": "Threshold",
      "author": "conky-studio",
      "version": "1.0.0",
      "description": "Compare a value to a threshold. Outputs 0/1, inverted 0/1, or passes the value when true (gate). Richer than the built-in Threshold Gate.",
      "color": "#d4a05a",
      "subcategory": "Plugins",
      "output_kind": "number",
      "tags": [
        "compare",
        "gate",
        "trigger"
      ],
      "simple_mode": true,
      "properties": [
        {
          "key": "value",
          "label": "Value",
          "kind": "float",
          "default": 50,
          "minimum": -1000000000.0,
          "maximum": 1000000000.0,
          "bindable": true,
          "accepts": [
            "number",
            "percent",
            "celsius"
          ],
          "group": "Input"
        },
        {
          "key": "threshold",
          "label": "Threshold",
          "kind": "float",
          "default": 80,
          "minimum": -1000000000.0,
          "maximum": 1000000000.0,
          "bindable": true,
          "accepts": [
            "number",
            "percent",
            "celsius"
          ],
          "group": "Input"
        },
        {
          "key": "mode",
          "label": "Mode",
          "kind": "enum",
          "default": "above",
          "choices": [
            "above",
            "below",
            "equal"
          ],
          "choice_labels": [
            "Above (≥)",
            "Below (≤)",
            "Equal (±ε)"
          ],
          "group": "Compare"
        },
        {
          "key": "output_mode",
          "label": "Output",
          "kind": "enum",
          "default": "binary",
          "choices": [
            "binary",
            "gate",
            "invert_binary"
          ],
          "choice_labels": [
            "0 or 1",
            "Pass value when true, else 0",
            "1 or 0 (inverted)"
          ],
          "group": "Output",
          "help": "binary → 1 when condition holds. gate → original value when true, else 0. invert_binary flips the 0/1."
        },
        {
          "key": "epsilon",
          "label": "Equal ε",
          "kind": "float",
          "default": 0.01,
          "minimum": 0,
          "maximum": 1000000.0,
          "step": 0.01,
          "group": "Compare",
          "help": "Tolerance used only when Mode is Equal"
        }
      ],
      "lua_expr": "(function()\n local v, th, eps = {value}, {threshold}, {epsilon}\n local mode, outm = '{mode}', '{output_mode}'\n local ok = false\n if mode == 'above' then ok = (v >= th)\n elseif mode == 'below' then ok = (v <= th)\n else ok = (math.abs(v - th) <= eps)\n end\n if outm == 'gate' then return ok and v or 0 end\n if outm == 'invert_binary' then return ok and 0 or 1 end\n return ok and 1 or 0\nend)()"
    },
    {
      "id": "logic.deadzone",
      "category": "logic",
      "label": "Deadzone",
      "author": "conky-studio",
      "version": "1.0.0",
      "description": "Zero-out values whose absolute magnitude is below a threshold. Optional soft ramp. Different model from the built-in centre+radius deadzone.",
      "color": "#8a8fa8",
      "subcategory": "Plugins",
      "output_kind": "number",
      "tags": [
        "filter",
        "noise",
        "math"
      ],
      "simple_mode": false,
      "properties": [
        {
          "key": "value",
          "label": "Value",
          "kind": "float",
          "default": 0,
          "minimum": -1000000000.0,
          "maximum": 1000000000.0,
          "bindable": true,
          "accepts": [
            "number",
            "percent",
            "celsius"
          ],
          "group": "Input"
        },
        {
          "key": "zone",
          "label": "Deadzone",
          "kind": "float",
          "default": 1,
          "minimum": 0,
          "maximum": 1000000000.0,
          "bindable": true,
          "accepts": [
            "number",
            "percent"
          ],
          "group": "Filter",
          "help": "Values with |value| < deadzone become 0 (or are scaled in soft mode)"
        },
        {
          "key": "soft",
          "label": "Soft edge",
          "kind": "bool",
          "default": false,
          "group": "Filter",
          "help": "If on, rescale so the deadzone is removed and the rest maps smoothly outward"
        }
      ],
      "lua_expr": "(function()\n local v, z = {value}, {zone}\n if z < 0 then z = 0 end\n local a = math.abs(v)\n if a <= z then return 0 end\n if not {soft} then return v end\n local sign = (v >= 0) and 1 or -1\n return sign * (a - z)\nend)()"
    },
    {
      "id": "logic.smooth",
      "category": "logic",
      "label": "Smooth (EMA)",
      "author": "conky-studio",
      "version": "1.0.0",
      "description": "Exponential moving average — tames jittery sensors. Unique Slot per instance so parallel smoothers do not share state.",
      "color": "#5fb89a",
      "subcategory": "Plugins",
      "output_kind": "number",
      "tags": [
        "filter",
        "ema",
        "smooth"
      ],
      "simple_mode": true,
      "lua_helpers": "local _cs_plugin_smooth = _cs_plugin_smooth or {}\n",
      "properties": [
        {
          "key": "value",
          "label": "Value",
          "kind": "float",
          "default": 0,
          "minimum": -1000000000.0,
          "maximum": 1000000000.0,
          "bindable": true,
          "accepts": [
            "number",
            "percent",
            "celsius"
          ],
          "group": "Input"
        },
        {
          "key": "alpha",
          "label": "Alpha",
          "kind": "float",
          "default": 0.2,
          "minimum": 0.01,
          "maximum": 1,
          "step": 0.01,
          "bindable": true,
          "accepts": [
            "number"
          ],
          "group": "Filter",
          "help": "1 = no smoothing. Smaller = heavier lag. 0.15–0.3 is a good start for CPU/net."
        },
        {
          "key": "slot",
          "label": "Slot",
          "kind": "int",
          "default": 1,
          "minimum": 1,
          "maximum": 9999,
          "step": 1,
          "group": "State",
          "help": "Unique integer per Smooth node (1, 2, 3…). Shared slots share memory."
        }
      ],
      "lua_expr": "(function()\n local k = {slot}\n local v, a = {value}, {alpha}\n if a < 0.01 then a = 0.01 elseif a > 1 then a = 1 end\n local s = _cs_plugin_smooth\n if s[k] == nil then s[k] = v end\n s[k] = s[k] + (v - s[k]) * a\n return s[k]\nend)()"
    },
    {
      "id": "logic.temp_convert",
      "category": "logic",
      "label": "Temp Convert",
      "author": "conky-studio",
      "version": "1.0.0",
      "description": "Convert temperature between Fahrenheit and Celsius.",
      "color": "#5eb0c9",
      "subcategory": "Plugins",
      "output_kind": "celsius",
      "tags": [
        "weather",
        "temperature",
        "units",
        "convert"
      ],
      "simple_mode": true,
      "properties": [
        {
          "key": "value",
          "label": "Temperature",
          "kind": "float",
          "default": 72,
          "minimum": -200,
          "maximum": 200,
          "step": 0.1,
          "bindable": true,
          "accepts": [
            "number",
            "celsius",
            "percent"
          ],
          "group": "Input"
        },
        {
          "key": "direction",
          "label": "Convert",
          "kind": "enum",
          "default": "f_to_c",
          "choices": [
            "f_to_c",
            "c_to_f"
          ],
          "choice_labels": [
            "°F → °C",
            "°C → °F"
          ],
          "group": "Units"
        },
        {
          "key": "decimals",
          "label": "Round to",
          "kind": "enum",
          "default": "1",
          "choices": [
            "none",
            "0",
            "1",
            "2"
          ],
          "choice_labels": [
            "No rounding",
            "Whole degrees",
            "1 decimal",
            "2 decimals"
          ],
          "group": "Output"
        }
      ],
      "lua_expr": "(function()\n local v = {value}\n local dir = '{direction}'\n local out\n if dir == 'c_to_f' then\n out = v * 9 / 5 + 32\n else\n out = (v - 32) * 5 / 9\n end\n local d = '{decimals}'\n if d == '0' then return math.floor(out + 0.5)\n elseif d == '1' then return math.floor(out * 10 + 0.5) / 10\n elseif d == '2' then return math.floor(out * 100 + 0.5) / 100\n end\n return out\nend)()"
    },
    {
