      "lua_draw_body": "  local r, g, b = {color}\n  local s, gap = {size}, {gap}\n  cairo_set_source_rgba(cr, r, g, b, {opacity})\n  cairo_set_line_width(cr, {thickness})\n  cairo_move_to(cr, {cx} - s, {cy}); cairo_line_to(cr, {cx} - gap, {cy})\n  cairo_move_to(cr, {cx} + gap, {cy}); cairo_line_to(cr, {cx} + s, {cy})\n  cairo_move_to(cr, {cx}, {cy} - s); cairo_line_to(cr, {cx}, {cy} - gap)\n  cairo_move_to(cr, {cx}, {cy} + gap); cairo_line_to(cr, {cx}, {cy} + s)\n  cairo_stroke(cr)\n"
    },
    {
      "id": "visual.plugin.rect",
      "category": "visual",
      "label": "Rectangle",
      "author": "conky-studio",
      "version": "1.0.0",
      "description": "Filled and/or stroked rectangle. Simple panel background or frame.",
      "color": "#8a5fd6",
      "subcategory": "Plugins",
      "tags": ["shape", "box", "panel"],
      "simple_mode": true,
      "properties": [
        { "key": "x", "label": "X", "kind": "float", "default": 20, "group": "Position" },
        { "key": "y", "label": "Y", "kind": "float", "default": 20, "group": "Position" },
        { "key": "width", "label": "Width", "kind": "float", "default": 120, "minimum": 1, "group": "Shape" },
        { "key": "height", "label": "Height", "kind": "float", "default": 40, "minimum": 1, "group": "Shape" },
        { "key": "fill", "label": "Fill", "kind": "bool", "default": true, "group": "Style" },
        { "key": "stroke", "label": "Stroke", "kind": "bool", "default": false, "group": "Style" },
        { "key": "line_width", "label": "Stroke width", "kind": "float", "default": 1.5, "minimum": 0.5, "maximum": 40, "step": 0.5, "group": "Style" },
        { "key": "color", "label": "Fill colour", "kind": "color", "default": "#1a2228", "group": "Style" },
        { "key": "stroke_color", "label": "Stroke colour", "kind": "color", "default": "#4fd1c5", "group": "Style" },
        { "key": "opacity", "label": "Opacity", "kind": "float", "default": 1, "minimum": 0, "maximum": 1, "step": 0.05, "group": "Style" }
      ],
      "lua_draw_body": "  local fr, fg, fb = {color}\n  local sr, sg, sb = {stroke_color}\n  cairo_rectangle(cr, {x}, {y}, {width}, {height})\n  if {fill} then\n    cairo_set_source_rgba(cr, fr, fg, fb, {opacity})\n    if {stroke} then cairo_fill_preserve(cr) else cairo_fill(cr) end\n  end\n  if {stroke} then\n    cairo_set_line_width(cr, {line_width})\n    cairo_set_source_rgba(cr, sr, sg, sb, {opacity})\n    cairo_stroke(cr)\n  end\n"
    }
