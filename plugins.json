    {
      "id": "logic.unit_format",
      "category": "logic",
      "label": "Unit Format",
      "author": "conky-studio",
      "version": "1.0.0",
      "description": "Format a number with prefix, suffix, and decimal places as text (e.g. 42.5 → '42.5 °C').",
      "color": "#9b8fd6",
      "subcategory": "Plugins",
      "output_kind": "text",
      "tags": ["format", "text", "units"],
      "simple_mode": true,
      "properties": [
        {
          "key": "value",
          "label": "Value",
          "kind": "float",
          "default": 0,
          "minimum": -1000000000.0,
          "maximum": 1000000000.0,
          "bindable": true,
          "accepts": ["number", "percent", "celsius"],
          "group": "Input"
        },
        {
          "key": "decimals",
          "label": "Decimals",
          "kind": "int",
          "default": 0,
          "minimum": 0,
          "maximum": 4,
          "group": "Format"
        },
        {
          "key": "prefix",
          "label": "Prefix",
          "kind": "string",
          "default": "",
          "group": "Format"
        },
        {
          "key": "suffix",
          "label": "Suffix",
          "kind": "string",
          "default": "",
          "group": "Format",
          "help": "e.g. ' %', ' °C', ' KiB/s'"
        }
      ],
      "lua_expr": "(function()\n local v = {value}\n if type(v) ~= 'number' then v = tonumber(v) or 0 end\n local d = math.floor({decimals} + 0.5)\n if d < 0 then d = 0 end\n local s = string.format('%.' .. d .. 'f', v)\n return '{prefix}' .. s .. '{suffix}'\nend)()"
    },
    {
      "id": "logic.rate_limit",
      "category": "logic",
      "label": "Rate Limit",
      "author": "conky-studio",
      "version": "1.0.0",
      "description": "Limit how fast a value can change per refresh (max step). Softens spikes without full EMA lag. Unique Slot per instance.",
      "color": "#5fb89a",
      "subcategory": "Plugins",
      "output_kind": "number",
      "tags": ["filter", "smooth", "rate"],
      "simple_mode": false,
      "lua_helpers": "local _cs_plugin_ratelimit = _cs_plugin_ratelimit or {}\n",
      "properties": [
        {
          "key": "value",
          "label": "Value",
          "kind": "float",
          "default": 0,
          "minimum": -1000000000.0,
          "maximum": 1000000000.0,
          "bindable": true,
          "accepts": ["number", "percent", "celsius"],
          "group": "Input"
        },
        {
          "key": "max_step",
          "label": "Max step",
          "kind": "float",
          "default": 5,
          "minimum": 0.001,
          "maximum": 1000000000.0,
          "step": 0.1,
          "group": "Filter",
          "help": "Maximum change allowed per sensor refresh."
        },
        {
          "key": "slot",
          "label": "Slot",
          "kind": "int",
          "default": 1,
          "minimum": 1,
          "maximum": 9999,
          "group": "State"
        }
      ],
      "lua_expr": "(function()\n local k = {slot}\n local v, step = {value}, {max_step}\n if step < 0 then step = 0 end\n local s = _cs_plugin_ratelimit\n if s[k] == nil then s[k] = v end\n local d = v - s[k]\n if d > step then d = step elseif d < -step then d = -step end\n s[k] = s[k] + d\n return s[k]\nend)()"
    },
    {
      "id": "logic.hold_peak",
      "category": "logic",
      "label": "Hold Peak",
      "author": "conky-studio",
      "version": "1.0.0",
      "description": "Remembers the highest value seen, with optional slow decay back down. Classic peak-hold for meters.",
      "color": "#d4a05a",
      "subcategory": "Plugins",
      "output_kind": "number",
      "tags": ["filter", "peak", "meter"],
      "simple_mode": false,
      "lua_helpers": "local _cs_plugin_peak = _cs_plugin_peak or {}\n",
      "properties": [
        {
          "key": "value",
          "label": "Value",
          "kind": "float",
          "default": 0,
          "minimum": -1000000000.0,
          "maximum": 1000000000.0,
          "bindable": true,
          "accepts": ["number", "percent", "celsius"],
          "group": "Input"
        },
        {
          "key": "decay",
          "label": "Decay per tick",
          "kind": "float",
          "default": 0.5,
          "minimum": 0,
          "maximum": 1000000000.0,
          "step": 0.1,
          "group": "Filter",
          "help": "How much the held peak falls each sensor refresh when below the live value. 0 = freeze forever."
        },
        {
          "key": "slot",
          "label": "Slot",
          "kind": "int",
          "default": 1,
          "minimum": 1,
          "maximum": 9999,
          "group": "State"
        }
      ],
      "lua_expr": "(function()\n local k = {slot}\n local v, dec = {value}, {decay}\n if dec < 0 then dec = 0 end\n local s = _cs_plugin_peak\n if s[k] == nil then s[k] = v end\n if v > s[k] then s[k] = v else s[k] = s[k] - dec end\n if s[k] < v then s[k] = v end\n return s[k]\nend)()"
    },
