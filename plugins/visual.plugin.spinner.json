{
  "id": "visual.plugin.spinner",
  "category": "visual",
  "label": "Spinner",
  "author": "Conky-Studio",
  "version": "1.0.0",
  "description": "Circular loading spinner (arc that rotates). Dim when Active < 0.5.",
  "color": "#8a5fd6",
  "subcategory": "Plugins",
  "tags": [
    "loading",
    "spinner",
    "animation"
  ],
  "simple_mode": true,
  "properties": [
    {
      "key": "cx",
      "label": "Center X",
      "kind": "float",
      "default": 40,
      "group": "Position",
      "minimum": 1,
      "maximum": 4000
    },
    {
      "key": "cy",
      "label": "Center Y",
      "kind": "float",
      "default": 40,
      "group": "Position",
      "minimum": 1,
      "maximum": 4000
    },
    {
      "key": "radius",
      "label": "Radius",
      "kind": "float",
      "default": 16,
      "minimum": 4,
      "maximum": 400,
      "group": "Shape"
    },
    {
      "key": "thickness",
      "label": "Thickness",
      "kind": "float",
      "default": 3.5,
      "minimum": 1,
      "maximum": 40,
      "group": "Shape"
    },
    {
      "key": "arc_deg",
      "label": "Arc length (deg)",
      "kind": "float",
      "default": 110,
      "minimum": 20,
      "maximum": 300,
      "group": "Shape"
    },
    {
      "key": "active",
      "label": "Active",
      "kind": "float",
      "default": 1,
      "bindable": true,
      "accepts": [
        "number",
        "percent",
        "boolean"
      ],
      "group": "Input"
    },
    {
      "key": "speed_dps",
      "label": "Rotation (deg/s)",
      "kind": "float",
      "default": 220,
      "minimum": -720,
      "maximum": 720,
      "group": "Animation"
    },
    {
      "key": "color",
      "label": "Colour",
      "kind": "color",
      "default": "#4fd1c5",
      "group": "Style"
    },
    {
      "key": "opacity",
      "label": "Opacity",
      "kind": "float",
      "default": 1.0,
      "minimum": 0,
      "maximum": 1,
      "step": 0.05,
      "group": "Style"
    }
  ],
  "lua_draw_body": "\n local cx, cy, R = {cx}, {cy}, {radius}\n local r, g, b = {color}\n local active = (tonumber({active}) or 0) >= 0.5\n local a = active and (wall_clock() * math.rad({speed_dps})) or 0\n local sweep = math.rad({arc_deg})\n cairo_set_line_width(cr, {thickness})\n cairo_set_line_cap(cr, CAIRO_LINE_CAP_ROUND)\n -- track\n cairo_set_source_rgba(cr, r, g, b, {opacity} * 0.15)\n cairo_new_sub_path(cr); cairo_arc(cr, cx, cy, R, 0, 2 * math.pi); cairo_stroke(cr)\n -- arc\n cairo_set_source_rgba(cr, r, g, b, {opacity} * (active and 1 or 0.25))\n cairo_new_sub_path(cr); cairo_arc(cr, cx, cy, R, a, a + sweep); cairo_stroke(cr)\n"
}
