{
  "id": "visual.plugin.hex_tile",
  "category": "visual",
  "label": "Hex Tile",
  "author": "Conky-Studio",
  "version": "1.0.0",
  "description": "Single filled hexagon, optional stroke. Building block for honeycomb HUDs.",
  "color": "#8a5fd6",
  "subcategory": "Plugins",
  "tags": [
    "hex",
    "shape",
    "tile"
  ],
  "simple_mode": true,
  "properties": [
    {
      "key": "cx",
      "label": "Center X",
      "kind": "float",
      "default": 60,
      "group": "Position",
      "minimum": 1,
      "maximum": 4000
    },
    {
      "key": "cy",
      "label": "Center Y",
      "kind": "float",
      "default": 60,
      "group": "Position",
      "minimum": 1,
      "maximum": 4000
    },
    {
      "key": "radius",
      "label": "Radius",
      "kind": "float",
      "default": 36,
      "minimum": 4,
      "maximum": 800,
      "group": "Shape"
    },
    {
      "key": "rotation_deg",
      "label": "Rotation",
      "kind": "float",
      "default": 0,
      "minimum": -360,
      "maximum": 360,
      "group": "Shape"
    },
    {
      "key": "fill",
      "label": "Fill",
      "kind": "bool",
      "default": true,
      "group": "Style"
    },
    {
      "key": "stroke",
      "label": "Stroke",
      "kind": "bool",
      "default": true,
      "group": "Style"
    },
    {
      "key": "line_width",
      "label": "Stroke width",
      "kind": "float",
      "default": 1.5,
      "minimum": 0.5,
      "maximum": 20,
      "group": "Style"
    },
    {
      "key": "color",
      "label": "Fill colour",
      "kind": "color",
      "default": "#1a2433",
      "group": "Style"
    },
    {
      "key": "stroke_color",
      "label": "Stroke colour",
      "kind": "color",
      "default": "#4fd1c5",
      "group": "Style"
    },
    {
      "key": "opacity",
      "label": "Opacity",
      "kind": "float",
      "default": 1.0,
      "minimum": 0,
      "maximum": 1,
      "step": 0.05,
      "group": "Style"
    }
  ],
  "lua_draw_body": "\n local cx, cy, R = {cx}, {cy}, {radius}\n local rot = math.rad({rotation_deg})\n cairo_new_sub_path(cr)\n for i = 0, 5 do\n  local a = rot + i * math.pi / 3\n  local px = cx + math.cos(a) * R\n  local py = cy + math.sin(a) * R\n  if i == 0 then cairo_move_to(cr, px, py) else cairo_line_to(cr, px, py) end\n end\n cairo_close_path(cr)\n if {fill} then\n  local r, g, b = {color}\n  cairo_set_source_rgba(cr, r, g, b, {opacity})\n  if {stroke} then cairo_fill_preserve(cr) else cairo_fill(cr) end\n end\n if {stroke} then\n  local r, g, b = {stroke_color}\n  cairo_set_line_width(cr, {line_width})\n  cairo_set_source_rgba(cr, r, g, b, {opacity})\n  cairo_stroke(cr)\n end\n"
}
