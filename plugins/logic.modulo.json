{
  "id": "logic.modulo",
  "category": "logic",
  "label": "Modulo",
  "author": "conky-studio",
  "version": "1.0.0",
  "description": "value mod divisor. Wrapping angles, cycling indices, stepped patterns.",
  "color": "#7a9ed6",
  "subcategory": "Plugins",
  "output_kind": "number",
  "tags": [
    "math",
    "wrap"
  ],
  "simple_mode": false,
  "properties": [
    {
      "key": "value",
      "label": "Value",
      "kind": "float",
      "default": 0,
      "minimum": -1000000000.0,
      "maximum": 1000000000.0,
      "bindable": true,
      "accepts": [
        "number",
        "percent",
        "celsius"
      ],
      "group": "Input"
    },
    {
      "key": "divisor",
      "label": "Divisor",
      "kind": "float",
      "default": 360,
      "minimum": -1000000000.0,
      "maximum": 1000000000.0,
      "bindable": true,
      "accepts": [
        "number",
        "percent"
      ],
      "group": "Input"
    }
  ],
  "lua_expr": "(function()\n local d = {divisor}\n if d == 0 then return 0 end\n return ({value}) % d\nend)()"
}
