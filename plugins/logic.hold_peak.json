{
  "id": "logic.hold_peak",
  "category": "logic",
  "label": "Hold Peak",
  "author": "conky-studio",
  "version": "1.0.0",
  "description": "Remembers the highest value seen, with optional slow decay. Classic peak-hold for meters.",
  "color": "#d4a05a",
  "subcategory": "Plugins",
  "output_kind": "number",
  "tags": [
    "filter",
    "peak",
    "meter"
  ],
  "simple_mode": false,
  "lua_helpers": "local _cs_plugin_peak = _cs_plugin_peak or {}\n",
  "properties": [
    {
      "key": "value",
      "label": "Value",
      "kind": "float",
      "default": 0,
      "minimum": -1000000000.0,
      "maximum": 1000000000.0,
      "bindable": true,
      "accepts": [
        "number",
        "percent",
        "celsius"
      ],
      "group": "Input"
    },
    {
      "key": "decay",
      "label": "Decay per tick",
      "kind": "float",
      "default": 0.5,
      "minimum": 0,
      "maximum": 1000000000.0,
      "step": 0.1,
      "group": "Filter"
    },
    {
      "key": "slot",
      "label": "Slot",
      "kind": "int",
      "default": 1,
      "minimum": 1,
      "maximum": 9999,
      "group": "State"
    }
  ],
  "lua_expr": "(function()\n local k = {slot}\n local v, dec = {value}, {decay}\n if dec < 0 then dec = 0 end\n local s = _cs_plugin_peak\n if s[k] == nil then s[k] = v end\n if v > s[k] then s[k] = v else s[k] = s[k] - dec end\n if s[k] < v then s[k] = v end\n return s[k]\nend)()"
}
