{
  "id": "logic.boolean_or",
  "category": "logic",
  "label": "OR (0/1)",
  "author": "conky-studio",
  "version": "1.0.0",
  "description": "Logical OR with configurable truth threshold. Output 1 or 0.",
  "color": "#8a8fa8",
  "subcategory": "Plugins",
  "output_kind": "number",
  "tags": [
    "logic",
    "boolean",
    "gate"
  ],
  "simple_mode": false,
  "properties": [
    {
      "key": "a",
      "label": "A",
      "kind": "float",
      "default": 0,
      "minimum": -1000000000.0,
      "maximum": 1000000000.0,
      "bindable": true,
      "accepts": [
        "number",
        "percent",
        "celsius",
        "boolean"
      ],
      "group": "Inputs"
    },
    {
      "key": "b",
      "label": "B",
      "kind": "float",
      "default": 0,
      "minimum": -1000000000.0,
      "maximum": 1000000000.0,
      "bindable": true,
      "accepts": [
        "number",
        "percent",
        "celsius",
        "boolean"
      ],
      "group": "Inputs"
    },
    {
      "key": "threshold",
      "label": "Truthy if ≥",
      "kind": "float",
      "default": 0.5,
      "minimum": -1000000000.0,
      "maximum": 1000000000.0,
      "group": "Compare"
    }
  ],
  "lua_expr": "((({a}) >= ({threshold}) or ({b}) >= ({threshold})) and 1 or 0)"
}
