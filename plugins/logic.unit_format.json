{
  "id": "logic.unit_format",
  "category": "logic",
  "label": "Unit Format",
  "author": "conky-studio",
  "version": "1.0.0",
  "description": "Format a number with prefix, suffix, and decimals as text (e.g. 42.5 → '42.5 °C').",
  "color": "#9b8fd6",
  "subcategory": "Plugins",
  "output_kind": "text",
  "tags": [
    "format",
    "text",
    "units"
  ],
  "simple_mode": true,
  "properties": [
    {
      "key": "value",
      "label": "Value",
      "kind": "float",
      "default": 0,
      "minimum": -1000000000.0,
      "maximum": 1000000000.0,
      "bindable": true,
      "accepts": [
        "number",
        "percent",
        "celsius"
      ],
      "group": "Input"
    },
    {
      "key": "decimals",
      "label": "Decimals",
      "kind": "int",
      "default": 0,
      "minimum": 0,
      "maximum": 4,
      "group": "Format"
    },
    {
      "key": "prefix",
      "label": "Prefix",
      "kind": "string",
      "default": "",
      "group": "Format"
    },
    {
      "key": "suffix",
      "label": "Suffix",
      "kind": "string",
      "default": "",
      "group": "Format",
      "help": "e.g. ' %', '  degC', ' KiB/s'"
    }
  ],
  "lua_expr": "(function()\n local v = {value}\n if type(v) ~= 'number' then v = tonumber(v) or 0 end\n local d = math.floor({decimals} + 0.5)\n if d < 0 then d = 0 end\n local s = string.format('%.' .. d .. 'f', v)\n return '{prefix}' .. s .. '{suffix}'\nend)()"
}
