{
  "id": "logic.plugin.rate_limit",
  "category": "logic",
  "label": "Rate Limit",
  "author": "conky-studio",
  "version": "1.0.0",
  "description": "Limit how fast a value can change per refresh (max step). Unique Slot per instance.",
  "color": "#5fb89a",
  "subcategory": "Plugins",
  "output_kind": "number",
  "tags": [
    "filter",
    "smooth",
    "rate"
  ],
  "simple_mode": false,
  "lua_helpers": "local _cs_plugin_ratelimit = _cs_plugin_ratelimit or {}\n",
  "properties": [
    {
      "key": "value",
      "label": "Value",
      "kind": "float",
      "default": 0,
      "minimum": -1000000000.0,
      "maximum": 1000000000.0,
      "bindable": true,
      "accepts": [
        "number",
        "percent",
        "celsius"
      ],
      "group": "Input"
    },
    {
      "key": "max_step",
      "label": "Max step",
      "kind": "float",
      "default": 5,
      "minimum": 0.001,
      "maximum": 1000000000.0,
      "step": 0.1,
      "group": "Filter"
    },
    {
      "key": "slot",
      "label": "Slot",
      "kind": "int",
      "default": 1,
      "minimum": 1,
      "maximum": 9999,
      "group": "State"
    }
  ],
  "lua_expr": "(function()\n local k = {slot}\n local v, step = {value}, {max_step}\n if step < 0 then step = 0 end\n local s = _cs_plugin_ratelimit\n if s[k] == nil then s[k] = v end\n local d = v - s[k]\n if d > step then d = step elseif d < -step then d = -step end\n s[k] = s[k] + d\n return s[k]\nend)()"
}
