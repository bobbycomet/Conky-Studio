{
  "id": "logic.plugin.boolean_not",
  "category": "logic",
  "label": "NOT (0/1)",
  "author": "conky-studio",
  "version": "1.0.0",
  "description": "Invert a 0/1 (or thresholded) signal. No built-in equivalent.",
  "color": "#8a8fa8",
  "subcategory": "Plugins",
  "output_kind": "number",
  "tags": [
    "logic",
    "boolean"
  ],
  "simple_mode": false,
  "properties": [
    {
      "key": "value",
      "label": "Value",
      "kind": "float",
      "default": 0,
      "minimum": -1000000000.0,
      "maximum": 1000000000.0,
      "bindable": true,
      "accepts": [
        "number",
        "percent",
        "boolean"
      ],
      "group": "Input"
    },
    {
      "key": "threshold",
      "label": "Truthy if \u2265",
      "kind": "float",
      "default": 0.5,
      "minimum": -1000000000.0,
      "maximum": 1000000000.0,
      "group": "Compare"
    }
  ],
  "lua_expr": "((({value}) >= ({threshold})) and 0 or 1)"
}
