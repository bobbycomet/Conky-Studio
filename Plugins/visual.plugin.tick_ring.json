{
  "id": "visual.plugin.tick_ring",
  "category": "visual",
  "label": "Tick Ring",
  "author": "conky-studio",
  "version": "1.0.0",
  "description": "Decorative radial tick marks -- chrome to stack under/around an Arc Gauge, Segmented Gauge, or in place of Analog Clock's built-in ticks.",
  "color": "#7a9ed6",
  "subcategory": "Plugins",
  "tags": [
    "shape",
    "chrome",
    "gauge",
    "decorative"
  ],
  "simple_mode": true,
  "properties": [
    {
      "key": "cx",
      "label": "Center X",
      "kind": "float",
      "default": 100,
      "group": "Position",
      "minimum": 1,
      "maximum": 4000
    },
    {
      "key": "cy",
      "label": "Center Y",
      "kind": "float",
      "default": 100,
      "group": "Position",
      "minimum": 1,
      "maximum": 4000
    },
    {
      "key": "radius",
      "label": "Radius",
      "kind": "float",
      "default": 90,
      "minimum": 4,
      "maximum": 2000,
      "group": "Shape"
    },
    {
      "key": "tick_count",
      "label": "Tick count",
      "kind": "int",
      "default": 12,
      "minimum": 1,
      "maximum": 200,
      "group": "Shape"
    },
    {
      "key": "tick_length",
      "label": "Tick length",
      "kind": "float",
      "default": 8,
      "minimum": 1,
      "maximum": 500,
      "group": "Shape"
    },
    {
      "key": "tick_width",
      "label": "Tick width",
      "kind": "float",
      "default": 2,
      "minimum": 0.2,
      "maximum": 50,
      "step": 0.2,
      "group": "Shape"
    },
    {
      "key": "start_angle_deg",
      "label": "Start angle",
      "kind": "float",
      "default": -90,
      "minimum": -360,
      "maximum": 360,
      "group": "Shape"
    },
    {
      "key": "sweep_deg",
      "label": "Sweep angle",
      "kind": "float",
      "default": 360,
      "minimum": 1,
      "maximum": 360,
      "group": "Shape"
    },
    {
      "key": "color",
      "label": "Colour",
      "kind": "color",
      "default": "#4fd1c5",
      "group": "Style"
    },
    {
      "key": "opacity",
      "label": "Opacity",
      "kind": "float",
      "default": 0.8,
      "minimum": 0,
      "maximum": 1,
      "step": 0.05,
      "group": "Style"
    }
  ],
  "lua_draw_body": " local r, g, b = {color}\n cairo_set_source_rgba(cr, r, g, b, {opacity})\n cairo_set_line_width(cr, {tick_width})\n local n = math.floor({tick_count} + 0.5)\n if n < 1 then n = 1 end\n local step = ({sweep_deg}) / n\n for i = 0, n - 1 do\n local a = math.rad(({start_angle_deg}) + i * step)\n local x1 = {cx} + math.cos(a) * ({radius} - {tick_length})\n local y1 = {cy} + math.sin(a) * ({radius} - {tick_length})\n local x2 = {cx} + math.cos(a) * {radius}\n local y2 = {cy} + math.sin(a) * {radius}\n cairo_move_to(cr, x1, y1)\n cairo_line_to(cr, x2, y2)\n cairo_stroke(cr)\n end\n"
}
