{
  "id": "visual.plugin.wave_line",
  "category": "visual",
  "label": "Wave Line",
  "author": "Conky-Studio",
  "version": "1.0.0",
  "description": "Animated sine / multi-sine wave. Amplitude scales with optional Trigger (CPU%, volume proxy, \u2026).",
  "color": "#8a5fd6",
  "subcategory": "Plugins",
  "tags": [
    "wave",
    "animation",
    "audio",
    "line"
  ],
  "simple_mode": false,
  "properties": [
    {
      "key": "x",
      "label": "X",
      "kind": "float",
      "default": 20,
      "minimum": 1,
      "maximum": 4000,
      "group": "Position"
    },
    {
      "key": "y",
      "label": "Baseline Y",
      "kind": "float",
      "default": 80,
      "minimum": 1,
      "maximum": 4000,
      "group": "Position"
    },
    {
      "key": "width",
      "label": "Width",
      "kind": "float",
      "default": 220,
      "minimum": 20,
      "maximum": 4000,
      "group": "Shape"
    },
    {
      "key": "amplitude",
      "label": "Base amplitude",
      "kind": "float",
      "default": 18,
      "minimum": 1,
      "maximum": 400,
      "group": "Shape"
    },
    {
      "key": "wavelength",
      "label": "Wavelength (px)",
      "kind": "float",
      "default": 60,
      "minimum": 8,
      "maximum": 1000,
      "group": "Shape"
    },
    {
      "key": "line_width",
      "label": "Line width",
      "kind": "float",
      "default": 2.0,
      "minimum": 0.5,
      "maximum": 20,
      "group": "Style"
    },
    {
      "key": "color",
      "label": "Colour",
      "kind": "color",
      "default": "#4fd1c5",
      "group": "Style"
    },
    {
      "key": "opacity",
      "label": "Opacity",
      "kind": "float",
      "default": 0.9,
      "minimum": 0,
      "maximum": 1,
      "step": 0.05,
      "group": "Style"
    },
    {
      "key": "speed",
      "label": "Scroll speed",
      "kind": "float",
      "default": 2.0,
      "minimum": -20,
      "maximum": 20,
      "step": 0.1,
      "group": "Animation"
    },
    {
      "key": "trigger",
      "label": "Trigger",
      "kind": "float",
      "default": 50,
      "bindable": true,
      "accepts": [
        "number",
        "percent"
      ],
      "group": "Drive",
      "help": "Scales amplitude. 0-100 typical."
    },
    {
      "key": "harmonics",
      "label": "Extra harmonics",
      "kind": "int",
      "default": 1,
      "minimum": 0,
      "maximum": 4,
      "group": "Shape"
    }
  ],
  "lua_draw_body": "\n local x0, y0, W = {x}, {y}, {width}\n local amp = {amplitude} * (0.25 + 0.75 * (math.min(tonumber({trigger}) or 0, 100) / 100))\n local wl = {wavelength}; if wl < 1 then wl = 1 end\n local t = wall_clock() * {speed}\n local r, g, b = {color}\n cairo_set_source_rgba(cr, r, g, b, {opacity})\n cairo_set_line_width(cr, {line_width})\n cairo_set_line_join(cr, CAIRO_LINE_JOIN_ROUND)\n local steps = math.max(32, math.floor(W / 3))\n cairo_new_path(cr)\n for i = 0, steps do\n  local u = i / steps\n  local px = x0 + u * W\n  local phase = (u * W / wl) * 2 * math.pi + t\n  local y = y0 + math.sin(phase) * amp\n  local h = math.floor({harmonics} + 0.5)\n  for k = 1, h do\n   y = y + math.sin(phase * (k + 1) + k) * (amp / (k + 2))\n  end\n  if i == 0 then cairo_move_to(cr, px, y) else cairo_line_to(cr, px, y) end\n end\n cairo_stroke(cr)\n"
}
