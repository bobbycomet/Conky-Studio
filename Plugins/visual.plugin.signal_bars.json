{
  "id": "visual.plugin.signal_bars",
  "category": "visual",
  "label": "Signal Bars",
  "author": "Conky-Studio",
  "version": "1.0.0",
  "description": "Classic cellular / Wi-Fi style signal bars driven by a 0\u2013100 value. Unlit bars use Track colour.",
  "color": "#8a5fd6",
  "subcategory": "Plugins",
  "tags": [
    "bars",
    "signal",
    "wifi",
    "gauge"
  ],
  "simple_mode": true,
  "properties": [
    {
      "key": "x",
      "label": "X",
      "kind": "float",
      "default": 20,
      "minimum": 1,
      "maximum": 4000,
      "group": "Position"
    },
    {
      "key": "y",
      "label": "Y (baseline)",
      "kind": "float",
      "default": 40,
      "minimum": 1,
      "maximum": 4000,
      "group": "Position"
    },
    {
      "key": "value",
      "label": "Value (0-100)",
      "kind": "float",
      "default": 70,
      "bindable": true,
      "accepts": [
        "number",
        "percent"
      ],
      "minimum": 0,
      "maximum": 10000,
      "group": "Data"
    },
    {
      "key": "bars",
      "label": "Bar count",
      "kind": "int",
      "default": 5,
      "minimum": 2,
      "maximum": 12,
      "group": "Shape"
    },
    {
      "key": "bar_width",
      "label": "Bar width",
      "kind": "float",
      "default": 6,
      "minimum": 1,
      "maximum": 40,
      "group": "Shape"
    },
    {
      "key": "gap",
      "label": "Gap",
      "kind": "float",
      "default": 3,
      "minimum": 0,
      "maximum": 20,
      "group": "Shape"
    },
    {
      "key": "max_height",
      "label": "Tallest bar",
      "kind": "float",
      "default": 28,
      "minimum": 4,
      "maximum": 400,
      "group": "Shape"
    },
    {
      "key": "color",
      "label": "Lit colour",
      "kind": "color",
      "default": "#4fd1c5",
      "group": "Style"
    },
    {
      "key": "track_color",
      "label": "Unlit colour",
      "kind": "color",
      "default": "#33313a",
      "group": "Style"
    },
    {
      "key": "opacity",
      "label": "Opacity",
      "kind": "float",
      "default": 1.0,
      "minimum": 0,
      "maximum": 1,
      "step": 0.05,
      "group": "Style"
    }
  ],
  "lua_draw_body": "\n local n = math.floor({bars} + 0.5); if n < 1 then n = 1 end\n local val = tonumber({value}) or 0\n local lit = math.floor((val / 100) * n + 0.0001)\n if lit > n then lit = n end\n local r, g, b = {color}\n local tr, tg, tb = {track_color}\n local bw, gap, mh = {bar_width}, {gap}, {max_height}\n for i = 1, n do\n  local h = mh * (i / n)\n  local bx = {x} + (i - 1) * (bw + gap)\n  local by = {y} - h\n  if i <= lit then\n   cairo_set_source_rgba(cr, r, g, b, {opacity})\n  else\n   cairo_set_source_rgba(cr, tr, tg, tb, {opacity} * 0.7)\n  end\n  cairo_rectangle(cr, bx, by, bw, h)\n  cairo_fill(cr)\n end\n"
}
