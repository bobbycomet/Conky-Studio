{
  "id": "visual.plugin.dot",
  "category": "visual",
  "label": "Dot",
  "author": "conky-studio",
  "version": "1.0.0",
  "description": "Filled circle always on (status LED, bullet, blip). Unlike LED Dot, no threshold \u2014 colour is fixed.",
  "color": "#8a5fd6",
  "subcategory": "Plugins",
  "tags": [
    "shape",
    "led",
    "blip"
  ],
  "simple_mode": true,
  "properties": [
    {
      "key": "x",
      "label": "X",
      "kind": "float",
      "default": 40,
      "minimum": 1,
      "maximum": 4000,
      "group": "Position"
    },
    {
      "key": "y",
      "label": "Y",
      "kind": "float",
      "default": 40,
      "minimum": 1,
      "maximum": 4000,
      "group": "Position"
    },
    {
      "key": "radius",
      "label": "Radius",
      "kind": "float",
      "default": 6,
      "minimum": 1,
      "maximum": 4000,
      "group": "Shape"
    },
    {
      "key": "color",
      "label": "Colour",
      "kind": "color",
      "default": "#4fd1c5",
      "group": "Style"
    },
    {
      "key": "opacity",
      "label": "Opacity",
      "kind": "float",
      "default": 1,
      "minimum": 0,
      "maximum": 1,
      "step": 0.05,
      "group": "Style"
    }
  ],
  "lua_draw_body": " local r, g, b = {color}\n cairo_set_source_rgba(cr, r, g, b, {opacity})\n cairo_arc(cr, {x}, {y}, {radius}, 0, 2 * math.pi)\n cairo_fill(cr)\n"
}
