{
  "id": "logic.plugin.temp_convert",
  "category": "logic",
  "label": "Temp Convert",
  "author": "conky-studio",
  "version": "1.0.0",
  "description": "Convert temperature between Fahrenheit and Celsius.",
  "color": "#5eb0c9",
  "subcategory": "Plugins",
  "output_kind": "celsius",
  "tags": [
    "weather",
    "temperature",
    "units",
    "convert"
  ],
  "simple_mode": true,
  "properties": [
    {
      "key": "value",
      "label": "Temperature",
      "kind": "float",
      "default": 72,
      "minimum": -200,
      "maximum": 200,
      "step": 0.1,
      "bindable": true,
      "accepts": [
        "number",
        "celsius",
        "percent"
      ],
      "group": "Input"
    },
    {
      "key": "direction",
      "label": "Convert",
      "kind": "enum",
      "default": "f_to_c",
      "choices": [
        "f_to_c",
        "c_to_f"
      ],
      "choice_labels": [
        "\u00b0F \u2192 \u00b0C",
        "\u00b0C \u2192 \u00b0F"
      ],
      "group": "Units"
    },
    {
      "key": "decimals",
      "label": "Round to",
      "kind": "enum",
      "default": "1",
      "choices": [
        "none",
        "0",
        "1",
        "2"
      ],
      "choice_labels": [
        "No rounding",
        "Whole degrees",
        "1 decimal",
        "2 decimals"
      ],
      "group": "Output"
    }
  ],
  "lua_expr": "(function()\n local v = {value}\n local dir = '{direction}'\n local out\n if dir == 'c_to_f' then\n out = v * 9 / 5 + 32\n else\n out = (v - 32) * 5 / 9\n end\n local d = '{decimals}'\n if d == '0' then return math.floor(out + 0.5)\n elseif d == '1' then return math.floor(out * 10 + 0.5) / 10\n elseif d == '2' then return math.floor(out * 100 + 0.5) / 100\n end\n return out\nend)()"
}
